# --- Splitter frontend environment (Vite reads these only at startup) ---

# Run the UI against the built-in MOCK API (no Django needed).
# Copy this file to .env.local, set true, then restart `npm run dev`.
VITE_USE_MOCKS=false

# Optional. Absolute origin of the API when the frontend and backend are hosted
# separately, e.g. https://api.example.com
# Leave EMPTY for local development: requests stay relative (/api/v1/...) and the
# Vite dev proxy forwards them to Django (Shared Contract R1.2-17).
VITE_API_BASE_URL=
